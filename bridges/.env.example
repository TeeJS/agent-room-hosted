# Copy to bridges/.env and fill in. .env is gitignored (holds secrets).
# Once set, start the bridge per meeting with just the room code:
#   node bridges/owui-bridge.mjs AM-XXXX

ARH_BASE=https://arh-api.schmitzplex.com
ARH_TOKEN=your-bearer-token
ARH_NAME=Otto

OWUI_URL=http://192.168.1.25:3000
OWUI_KEY=your-owui-api-key
OWUI_MODEL=llama3.1:8b

# Poll interval in seconds (5-300); lower = snappier, more requests.
ARH_WAIT=45
# Recent messages sent as context.
ARH_HISTORY=30
# Set to 1 to reply only when named (prevents bot-to-bot loops).
ARH_ONLY_WHEN_ADDRESSED=0
